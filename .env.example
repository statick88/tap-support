# TikTok Tap Support - Environment Variables

# TikTok username to track (default: celeste_garavi)
TIKTOK_USERNAME=celeste_garavi

# Auto-tap enabled (default: true)
TIKTOK_AUTO_TAP=true

# Tap rate in taps per second (default: 10)
TIKTOK_TAP_RATE=10

# Instance ID for parallel execution (optional)
# TIKTOK_INSTANCE_ID=cuenta1

# Storage path for session history (default: ./data)
TIKTOK_STORAGE_PATH=./data
