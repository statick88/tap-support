# =============================================================================
# EditorConfig is awesome: https://EditorConfig.org
# Built by Statick | https://statick.dev
# =============================================================================

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# Go files
[*.go]
indent_style = tab
indent_size = 4

# Markdown and documentation files
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# YAML files
[*.{yaml,yml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2

# Makefile
[Makefile]
indent_style = tab

# Docker files
[Dockerfile]
indent_style = space
indent_size = 2

# GitHub workflow files
[.github/workflows/*.yml]
indent_style = space
indent_size = 2

# Configuration files
[*.{toml,toml.in}]
indent_style = space
indent_size = 2